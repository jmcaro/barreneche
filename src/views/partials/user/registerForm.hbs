<!-- component -->

<div class=" font-sans m-auto">
  <div class="relative min-h-screen flex flex-col sm:justify-center items-center">
    <div class="relative sm:max-w-sm md:max-w-screen-md w-full">
      <div class="card bg-blue-ua shadow-lg w-full h-full rounded-3xl absolute transform -rotate-6"></div>
      <div class="card bg-orange-ua shadow-lg w-full h-full rounded-3xl absolute transform rotate-6"></div>
      <div class="relative w-full rounded-3xl px-6 py-4 bg-gray-100 shadow-md">
        <div class="w-52 mx-auto">
          <img src="/img/Logotipo.png" alt="Consultorio Contable UA" srcset="">
        </div>
        <form method="POST" action="{{#if user}}/usuarios/{{user.id}}?_method=PUT{{else}}/signUp{{/if}}" class="">
          {{#if user}}<input type="hidden" name="_method" value="PUT" />{{/if}}
          <div class="space-x-2 space-y-3 grid md:grid-cols-2 sm:grid-cols-1">
            <div class="mt-3 ml-2">
              <select name="tipoDocumento" id="tipoDocumento" placeholder="Tipo de documento"
                class="mt-1 px-2 block w-full border border-slate-300 bg-gray-100 h-11 rounded-xl shadow-lg hover:bg-blue-100 focus:bg-blue-100 focus:ring-0">
                <option disabled selected="selected">Tipo de documento</option>
                <option value="CC">Cédula de ciudadanía</option>
                <option value="CE">Cédula de extranjeria</option>
                <option value="NIT">NIT</option>
              </select>

            </div>
            <div class="">
              <input value="{{user.numeroDocumento}}" type="number" name="numeroDocumento"
                placeholder="Número de documento"
                class="mt-1 px-2 block w-full border border-slate-300 bg-gray-100 h-11 rounded-xl shadow-lg hover:bg-blue-100 focus:bg-blue-100 focus:ring-0" />
            </div>

            <div class="">
              <input value="{{#if user.primerNombre}}{{user.primerNombre}}{{/if}}" type="text" name="primerNombre"
                placeholder="Primer Nombre"
                class="mt-1 px-2 block w-full border border-slate-300 bg-gray-100 h-11 rounded-xl shadow-lg hover:bg-blue-100 focus:bg-blue-100 focus:ring-0" />
            </div>

            <div class="">
              <input value="{{user.segundoNombre}}" type="text" name="segundoNombre" placeholder="Segundo Nombre"
                class="mt-1 px-2 block w-full border border-slate-300 bg-gray-100 h-11 rounded-xl shadow-lg hover:bg-blue-100 focus:bg-blue-100 focus:ring-0" />
            </div>
            <div class="">
              <input value="{{user.primerApellido}}" type="text" name="primerApellido" placeholder="Primer Apellido"
                class="mt-1 px-2 block w-full border border-slate-300 bg-gray-100 h-11 rounded-xl shadow-lg hover:bg-blue-100 focus:bg-blue-100 focus:ring-0" />
            </div>

            <div class="">
              <input value="{{user.segunApellido}}" type="text" name="segundoApellido" placeholder="Segundo Apellido"
                class="mt-1 px-2 block w-full border border-slate-300 bg-gray-100 h-11 rounded-xl shadow-lg hover:bg-blue-100 focus:bg-blue-100 focus:ring-0" />
            </div>
            <div class="">
              <input value="{{user.correo}}" type="email" name="correo" placeholder="Correo Electrónico"
                class="mt-1 px-2 block w-full border border-slate-300 bg-gray-100 h-11 rounded-xl shadow-lg hover:bg-blue-100 focus:bg-blue-100 focus:ring-0" />
            </div>
            <div class="">
              <input value="{{user.nacimento}}" id="calendar" type="datetime-local" name="nacimiento"
                placeholder="Fecha de nacimiento"
                class="mt-1 px-2 block w-full border border-slate-300 bg-gray-100 h-11 rounded-xl shadow-lg hover:bg-blue-100 focus:bg-blue-100 focus:ring-0" />
            </div>

            <div class="">
              <input value="{{user.telefono}}" type="tel" name="telefono" placeholder="Número de telefono"
                class="mt-1 px-2 block w-full border border-slate-300 bg-gray-100 h-11 rounded-xl shadow-lg hover:bg-blue-100 focus:bg-blue-100 focus:ring-0" />
            </div>
            <div class="mt-3 ml-2">
              <select name="sexo" id="sexo" placeholder="Sexo"
                class="mt-1 px-2 block w-full border border-slate-300 bg-gray-100 h-11 rounded-xl shadow-lg hover:bg-blue-100 focus:bg-blue-100 focus:ring-0">
                <option disabled selected="selected">Sexo</option>
                <option value="M">Masculino</option>
                <option value="F">Femenino</option>
                <option value="E">Empresa</option>
              </select>

            </div>
            <div class="mt-3 ml-2 col-span-2">
              <select name="rolesId" id="rol" placeholder="Tipo de Usuario"
                class="mt-1 px-2 block w-full border border-slate-300 bg-gray-100 h-11 rounded-xl shadow-lg hover:bg-blue-100 focus:bg-blue-100 focus:ring-0">
                <option disabled selected="selected">Tipo de usuario</option>
                {{#each roles}}

                <option value="{{id}}">{{rol}}</option>
                {{/each}}


              </select>

            </div>
            {{#if user}}

            {{else}}
            <div class="">
              <input type="password" name="password" placeholder="Contraseña"
                class="mt-1 px-2 block w-full border border-slate-300 bg-gray-100 h-11 rounded-xl shadow-lg hover:bg-blue-100 focus:bg-blue-100 focus:ring-0" />
            </div>

            <div class="">
              <input type="password" name="password2" placeholder="Confirmar contraseña"
                class="mt-1 px-2 block w-full border border-slate-300 bg-gray-100 h-11 rounded-xl shadow-lg hover:bg-blue-100 focus:bg-blue-100 focus:ring-0" />
            </div>

            {{/if}}



          </div>

          <div class="mt-5 flex justify-center">
            <button
              class="{{#if user}}bg-orange-ua{{else}}bg-blue-ua{{/if}} w-full md:max-w-lg py-3 rounded-xl text-white shadow-xl hover:shadow-inner focus:outline-none transition duration-500 ease-in-out transform hover:-translate-x hover:scale-105">
              {{#if user}}Actualizar{{else}}Registrar{{/if}}
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script>
  flatpickr("#calendar", {});
</script>