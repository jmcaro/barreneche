<dialog id="my_modal_1" class="modal">
    <div class="modal-box">
        <h2 class="card-title text-center justify-center">Crear Rol</h2>
        <div class="modal-action">
            <form class="w-full max-w-sm mx-auto bg-white p-8 rounded-md" method="post" action="/roles">
                <div class="mb-4">
                    <label class="block text-gray-700 text-sm font-bold mb-2" for="name">Nombre del Rol</label>
                    <input
                        class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:border-indigo-500"
                        type="text" id="name" name="rol" placeholder="Rol">
                </div>
                <button class="btn btn-primary w-full hover:bg-indigo-600 transition duration-300"
                    type="submit">Crear</button>
            </form>
        </div>
    </div>
</dialog>