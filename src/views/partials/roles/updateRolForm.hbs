<dialog id="updateModal" class="modal">
    <div class="modal-box">
        <h2 class="card-title text-center justify-center">Actualizar Rol</h2>
        <div class="modal-action">
            <form id="formUpdateRol" class="w-full max-w-sm mx-auto bg-white p-8 rounded-md" method="post">
                <input type="hidden" name="_method" value="PUT" />
                <div class="mb-4">
                    <label class="block text-gray-700 text-sm font-bold mb-2" for="name">Nombre del Rol</label>
                    <input
                        class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:border-indigo-500"
                        type="text" id="name" name="rol" placeholder="Rol">
                </div>
                <button class="btn btn-secondary w-full hover:bg-indigo-600 transition duration-300"
                    type="submit">Actualizar</button>
            </form>
        </div>
    </div>
</dialog>