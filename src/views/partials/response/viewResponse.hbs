<div class="container mx-auto p-6 bg-white shadow-lg rounded-lg">
  <div class="text-center mb-6">
    <h1 class="text-3xl font-bold text-blue-900">Respuesta a la Consulta</h1>
    <div class="badge badge-primary gap-2 badge-lg">#{{respuesta.Consultum.ticketNumber}}</div>
  </div>

  <div class="divider"></div>

  <div class="mb-4">
    <h2 class="text-xl font-semibold text-gray-700">Introducción</h2>
    <p class="text-gray-600">{{respuesta.introduccion}}</p>
  </div>

  <div class="mb-4">
    <h2 class="text-xl font-semibold text-gray-700">Análisis</h2>
    <p class="text-gray-600">{{respuesta.analisis}}</p>
  </div>

  <div class="mb-4">
    <h2 class="text-xl font-semibold text-gray-700">Respuesta</h2>
    <p class="text-gray-600">{{respuesta.respuesta}}</p>
  </div>

  <div class="mb-4">
    <h2 class="text-xl font-semibold text-gray-700">Recomendaciones</h2>
    <p class="text-gray-600">{{respuesta.recomendaciones}}</p>
  </div>

  <div class="mb-4">
    <h2 class="text-xl font-semibold text-gray-700">Cierre</h2>
    <p class="text-gray-600">{{respuesta.cierre}}</p>
  </div>

  <div class="text-center mt-6">
    <a href="/consultas" class="btn btn-primary">Volver a Consultas</a>
  </div>
</div>