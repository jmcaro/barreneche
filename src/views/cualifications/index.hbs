{{>sidebar}}
<div class="m-1 p-3 w-4/5 h-screen border rounded-md bg-slate-100 mx-auto">
    <div class="flex items-center">
        <h1 class="text-2xl font-semibold ml-4 ">Calificaciones</h1>
        <a href="#" class="btn btn-sm btn-accent ml-4">Ayuda<svg xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
                <path fill-rule="evenodd"
                    d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25ZM12.75 9a.75.75 0 0 0-1.5 0v2.25H9a.75.75 0 0 0 0 1.5h2.25V15a.75.75 0 0 0 1.5 0v-2.25H15a.75.75 0 0 0 0-1.5h-2.25V9Z"
                    clip-rule="evenodd" />
            </svg>

            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
        </a>
    </div>
    <div class="divider"></div>
    <div class="overflow-x-auto">
    {{#if cualifications.length}}
    <table class="table-auto w-full border-collapse">
        <thead>
            <tr class="bg-gray-100 border-b">
                <th class="p-4 text-left">Número de Ticket</th>
                <th class="p-4 text-left">Estudiante</th>
                <th class="p-4 text-left">Calificación</th>
                <th class="p-4 text-left">Comentario</th>
                <th class="p-4 text-left">Fecha de Consulta</th>
                <th class="p-4 text-left">Acciones</th>
            </tr>
        </thead>
        <tbody>
            {{#each cualifications}}
            <tr class="border-b hover:bg-gray-50">
                <!-- Número de Ticket de la Consulta -->
                <td class="p-4">{{formatTicketNumber Consultum.ticketNumber}}</td>


                <!-- Usuarios Estudiante -->
                <td class="p-4">
                    {{#if Consultum.Usuarios.length}}
                    <ul>
                        {{#each Consultum.Usuarios}}
                            {{#if (eq roles.rol 'Estudiante')}}
                            <li id="{{UserConsultation.ConsultaId}}">{{primerNombre}} {{primerApellido}} ({{roles.rol}})
                                {{UserConsultation.ConsultaID}}
                            </li>
                            {{/if}}
                        {{/each}}
                    </ul>
                    {{else}}
                    <span class="text-gray-500">No hay usuarios asignados</span>
                    {{/if}}
                </td>
                
                <!-- Calificación -->
                <td class="p-4">{{calificacion}}</td>

                <!-- Comentario -->
                <td class="p-4">{{comentario}}</td>

                <!-- Fecha de consulta -->
                <td class="p-4">{{formatDate Consultum.createdAt "DD/MM/YYYY"}}</td>

                <!-- Fecha de respuesta -->
                


                <!-- Acciones para Editar y Eliminar -->
                <td class="p-4">
                   <button onclick="createCualification.showModal()" class="btn btn-xs btn-info">Calificar</button>
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>
    {{else}}
    <p class="text-gray-500">No hay respuestas disponibles.</p>
    {{/if}}
    </div>
</div>
{{!-- mODAL CREAR calificacion --}}
<dialog id="createCualification" class="modal">
    <div class="modal-box w-1/3 max-w-5xl">
        {{>cualification/createCualification}}
        <div class="modal-action">
            <form method="dialog">
                <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
            </form>
            <form method="dialog">
                <!-- if there is a button, it will close the modal -->
                <button class="btn">Close</button>
            </form>
        </div>
    </div>
</dialog>