{{>sidebar}}
<div class="m-2 p-3 w-full h-auto border rounded-md bg-slate-100">
    <div class="flex items-center">
        <h1 class="text-2xl font-semibold ml-4 ">Categorias</h1>
        <button onclick="my_modal_1.showModal()" class="btn btn-sm btn-primary ml-4">Crear <svg
                xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
                <path fill-rule="evenodd"
                    d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25ZM12.75 9a.75.75 0 0 0-1.5 0v2.25H9a.75.75 0 0 0 0 1.5h2.25V15a.75.75 0 0 0 1.5 0v-2.25H15a.75.75 0 0 0 0-1.5h-2.25V9Z"
                    clip-rule="evenodd" />
            </svg>

            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
        </button>
    </div>
    <div class="divider"></div>
    {{>categories/createCatForm}}
    {{>categories/updateCatForm}}
    {{>roles/deleteConfirmationModal}}

    <div class="relative flex flex-col items-center gap-16 mx-auto my-10">
        <div class="grid w-full grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
            {{#each categorias}}
            <div class="flex flex-col items-center gap-3 px-8 py-10 bg-white rounded-3xl shadow-md">
                <span>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                        stroke="currentColor" class="w-10 h-10 text-orange-ua">
                        <path stroke-linecap="round" stroke-linejoin="round"
                            d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                    </svg>
                </span>
                <p id="{{id}}" class="text-2xl font-extrabold text-dark-grey-900 uppercase">{{categoria}}</p>
                <p id="{{id}}1" class="text-base leading-7 text-dark-grey-600 text-center capitalize">{{descripcion}}
                </p>
                <div class="flex space-x-2">
                    <button onclick=updateFillFormCat('{{id}}') class="btn w-24 btn-accent">Editar</button>
                    <button onclick=deleteConfirmation('{{id}}','/categorias/delete')
                        class="btn w-24  btn-error">Borrar</button>
                </div>
            </div>

            {{/each}}
        </div>
    </div>
</div>