{{>sidebar}}
{{>roles/deleteConfirmationModal}}
<div class="m-1 p-3 w-full h-auto border rounded-md bg-slate-100">
    <div class="flex items-center">
        <h1 class="text-2xl font-semibold ml-4 ">Consultas</h1>
        <a href="/consultas/create" class="btn btn-sm btn-primary ml-4">Crear <svg xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
                <path fill-rule="evenodd"
                    d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25ZM12.75 9a.75.75 0 0 0-1.5 0v2.25H9a.75.75 0 0 0 0 1.5h2.25V15a.75.75 0 0 0 1.5 0v-2.25H15a.75.75 0 0 0 0-1.5h-2.25V9Z"
                    clip-rule="evenodd" />
            </svg>

            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
        </a>
    </div>
    <div class="divider"></div>
    <div class="overflow-x-auto">
        <table class="table table-zebra table-xs bg-white">
            <!-- head -->
            <thead>
                <tr>
                    <th>#</th>
                    <th>Fecha de consulta</th>
                    <th>Categoria</th>
                    <th>Nombres</th>
                    <th>Razón social</th>
                    <th>Estado</th>
                    <th>Consulta</th>
                    <th>Correo</th>
                    <th>Lider</th>
                    <th>Estudiante</th>
                    <th>Acciones</th>

                </tr>
            </thead>
            <tbody>
                <!-- row 1 -->
                {{#each consultas}}
                <tr class="hover">
                    <th>{{@index}}</th>
                    <td>{{formatDate createdAt "DD/MM/YYYY"}}</td>
                    <td>{{categoria.categoria}}</td>
                    <td class="capitalize">{{primerNombre}} {{primerApellido}}</td>
                    <td>{{razonSocial}}</td>
                    <td>
                        <div class="badge badge-accent badge-lg text-xs text-slate-100 leading-3 text-center">{{estado}}
                        </div>
                    </td>
                    <td>{{consulta}}</td>
                    <td>{{correo}}</td>


                    <!-- Columna Líder -->
                    <td>
                        {{#if (hasAnyRole this.Usuarios "Profesor" "Administrador")}}
                        {{#each this.Usuarios}}
                        {{#if (or (eq this.roles.rol "Profesor") (eq this.roles.rol "Administrador"))}}
                        {{this.primerNombre}} {{this.primerApellido}} <br>
                        {{/if}}
                        {{/each}}
                        {{else}}
                        Sin Asignar
                        {{/if}}
                    </td>

                    <!-- Columna Estudiante -->
                    <td>
                        {{#if (hasRole this.Usuarios "Estudiante")}}
                        {{#each this.Usuarios}}
                        {{#if (eq this.roles.rol "Estudiante")}}
                        {{this.primerNombre}} {{this.primerApellido}} <br>
                        {{/if}}
                        {{/each}}
                        {{else}}
                        Sin Asignar
                        {{/if}}
                    </td>

                    <td>
                        <div class="inline-flex items-center rounded-md shadow-sm">
                            <a href="/usuarios/{{id}}"
                                class="text-slate-800 hover:text-blue-600 text-sm bg-white hover:bg-slate-100 border border-slate-200 rounded-l-lg font-medium px-4 py-2 inline-flex space-x-1 items-center">
                                <span><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                        stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                            d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
                                    </svg>
                                </span>
                            </a>
                            <button
                                class="text-slate-800 hover:text-blue-600 text-sm bg-white hover:bg-slate-100 border-y border-slate-200 font-medium px-4 py-2 inline-flex space-x-1 items-center">
                                <span>
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                        stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                            d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                            d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                    </svg>
                                </span>
                            </button>
                            <button onclick=deleteConfirmation('{{id}}','/usuarios/delete')
                                class="text-slate-800 hover:text-blue-600 text-sm bg-white hover:bg-slate-100 border border-slate-200 rounded-r-lg font-medium px-4 py-2 inline-flex space-x-1 items-center">
                                <span>
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                        stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                            d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                                    </svg>
                                </span>
                            </button>
                        </div>
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</div>
<script src="/js/utils.js"></script>