<!-- component -->
{{!-- {{>sidebar}} --}}
<div class="my-5 font-sans m-auto md:w-3/4 sm:w-2/4">
  <div class="flex items-center">
    {{#if usuario}}
    <a href="/consultas" class="btn btn-sm btn-primary ml-4"><svg xmlns="http://www.w3.org/2000/svg" fill="none"
        viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 15 3 9m0 0 6-6M3 9h12a6 6 0 0 1 0 12h-3" />
      </svg>


      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
      </svg>
    </a>
      <h1 class="text-2xl font-semibold ml-4">
        {{#if consulta}}
          Editar Ticket
          <div class="badge badge-error gap-2 badge-lg">#{{consulta.ticketNumber}}</div>
        {{else}}
          Crear Nueva Consulta
        {{/if}}
      </h1>
    {{/if}}
  </div>
  <div class="divider"></div>
  <div class="relative min-h-screen flex flex-col sm:justify-center items-center">
    <h1 class="text-4xl font-bold text-center mb-6 text-blue-ua">Realiza tu consulta</h1>
    <div class="relative sm:max-w-sm md:max-w-screen-md w-full">
      {{!-- <div class="card bg-blue-ua shadow-lg w-full h-full rounded-3xl absolute transform -rotate-6"></div>
      <div class="card bg-orange-ua shadow-lg w-full h-full rounded-3xl absolute transform rotate-6"></div> --}}
      <div class="relative w-full rounded-3xl px-6 py-4 bg-gray-100 shadow-md">
        <div class="w-52 mx-auto">
          <img src="/img/Logotipo.png" alt="Consultorio Contable UA" srcset="">
        </div>
        <form method="POST"
          action="{{#if consulta}}/consultas/edit/{{consulta.id}}?_method=PUT{{else}}/consultas{{/if}}" class="">
          {{#if consulta}}<input type="hidden" name="_method" value="PUT" />{{/if}}
          <div class="space-x-2 space-y-3 grid md:grid-cols-2 sm:grid-cols-1">
            <div class="mt-3 ml-2 sm:col-span-2 md:col-span-1">
              <select name="tipoIdentificacion" id="tipoIdentificacion" placeholder="Tipo de documento"
                class="mt-1 px-2 block w-full border border-slate-300 bg-gray-100 h-11 rounded-xl shadow-lg hover:bg-blue-100 focus:bg-blue-100 focus:ring-0">
                <option disabled selected="selected">Tipo de documento</option>
                <option value="CC" {{#if (eq consulta.tipoIdentificacion "CC" )}}selected{{/if}}>Cédula de ciudadanía
                </option>
                <option value="CE" {{#if (eq consulta.tipoIdentificacion "CE" )}}selected{{/if}}>Cédula de extranjería
                </option>
                <option value="NIT" {{#if (eq consulta.tipoIdentificacion "NIT" )}}selected{{/if}}>NIT</option>
              </select>

            </div>
            <div class="sm:col-span-2 md:col-span-1">
              <input value="{{consulta.numeroIdentificacion}}" type="number" name="numeroIdentificacion"
                placeholder="Número de documento"
                class="mt-1 px-2 block w-full border border-slate-300 bg-gray-100 h-11 rounded-xl shadow-lg hover:bg-blue-100 focus:bg-blue-100 focus:ring-0" />
            </div>

            <div class="sm:col-span-2 md:col-span-1">
              <input value="{{#if consulta.primerNombre}}{{consulta.primerNombre}}{{/if}}" type="text"
                name="primerNombre" placeholder="Primer Nombre"
                class="mt-1 px-2 block w-full border border-slate-300 bg-gray-100 h-11 rounded-xl shadow-lg hover:bg-blue-100 focus:bg-blue-100 focus:ring-0" />
            </div>

            <div class="sm:col-span-2 md:col-span-1">
              <input value="{{consulta.segundoNombre}}" type="text" name="segundoNombre" placeholder="Segundo Nombre"
                class="mt-1 px-2 block w-full border border-slate-300 bg-gray-100 h-11 rounded-xl shadow-lg hover:bg-blue-100 focus:bg-blue-100 focus:ring-0" />
            </div>
            <div class="sm:col-span-2 md:col-span-1">
              <input value="{{consulta.primerApellido}}" type="text" name="primerApellido" placeholder="Primer Apellido"
                class="mt-1 px-2 block w-full border border-slate-300 bg-gray-100 h-11 rounded-xl shadow-lg hover:bg-blue-100 focus:bg-blue-100 focus:ring-0" />
            </div>

            <div class="sm:col-span-2 md:col-span-1">
              <input value="{{consulta.segunApellido}}" type="text" name="segundoApellido"
                placeholder="Segundo Apellido"
                class="mt-1 px-2 block w-full border border-slate-300 bg-gray-100 h-11 rounded-xl shadow-lg hover:bg-blue-100 focus:bg-blue-100 focus:ring-0" />
            </div>
            <div class="sm:col-span-2">
              <input value="{{consulta.razonSocial}}" type="text" name="razonSocial" placeholder="Razón social"
                class="mt-1 px-2 block w-full border border-slate-300 bg-gray-100 h-11 rounded-xl shadow-lg hover:bg-blue-100 focus:bg-blue-100 focus:ring-0" />
            </div>
            <div class="sm:col-span-2 md:col-span-1">
              <input value="{{consulta.correo}}" type="email" name="correo" placeholder="Correo Electrónico"
                class="mt-1 px-2 block w-full border border-slate-300 bg-gray-100 h-11 rounded-xl shadow-lg hover:bg-blue-100 focus:bg-blue-100 focus:ring-0" />
            </div>

            <div class="sm:col-span-2 md:col-span-1">
              <input value="{{consulta.telefono}}" type="tel" name="telefono" placeholder="Número de telefono"
                class="mt-1 px-2 block w-full border border-slate-300 bg-gray-100 h-11 rounded-xl shadow-lg hover:bg-blue-100 focus:bg-blue-100 focus:ring-0" />
            </div>


            <div class="mt-3 ml-2 sm:col-span-2 md:col-span-1">
              <select name="sexo" id="sexo" placeholder="Sexo"
                class="mt-1 px-2 block w-full border border-slate-300 bg-gray-100 h-11 rounded-xl shadow-lg hover:bg-blue-100 focus:bg-blue-100 focus:ring-0">
                <option disabled selected="selected">Sexo</option>
                <option value="M" {{#if (eq consulta.sexo "M" )}}selected{{/if}}>Masculino</option>
                <option value="F" {{#if (eq consulta.sexo "F" )}}selected{{/if}}>Femenino</option>
                <option value="E" {{#if (eq consulta.sexo "E" )}}selected{{/if}}>Empresa</option>
              </select>

            </div>
            <div class="mt-3 ml-2 sm:col-span-2 md:col-span-1">
              <select name="categoriaId" id="categoria" placeholder="Categoría"
                class="mt-1 px-2 block w-full border uppercase border-slate-300 bg-gray-100 h-11 rounded-xl shadow-lg hover:bg-blue-100 focus:bg-blue-100 focus:ring-0">
                <option disabled selected="selected">Categorias</option>
                {{#each categorias}}
                <option value="{{id}}" {{#if (eq id ../consulta.categoriaId)}}selected{{/if}}>{{categoria}}</option>
                {{/each}}
              </select>
            </div>
            {{#if consulta}}
            <div class="mt-3 ml-2 sm:col-span-2 md:col-span-2">
              <select name="estado" id="estado" placeholder="Estado"
                class="mt-1 px-2 block w-full border uppercase border-slate-300 bg-gray-100 h-11 rounded-xl shadow-lg hover:bg-blue-100 focus:bg-blue-100 focus:ring-0">
                <option disabled selected="selected">Estado</option>
                {{#each estados}}
                <option value="{{this}}" {{#if (eq this ../consulta.estado)}}selected{{/if}}>{{this}}</option>
                {{/each}}
              </select>
            </div>
            {{/if}}

            <div class="mt-3 ml-2 col-span-2">
              <textarea placeholder="Realice su consulta en este espacio" id="consulta" name="consulta" rows="4"
                class="block w-full textarea textarea-bordered textarea-primary  border-slate-300 bg-gray-100 rounded-xl shadow-lg hover:bg-blue-100 focus:bg-blue-100 focus:ring-0">{{consulta.consulta}}</textarea>
            </div>

          </div>

          <div class="mt-5 flex justify-center">
            <button
              class="{{#if consulta}}bg-orange-ua{{else}}bg-blue-ua{{/if}} w-full md:max-w-lg py-3 rounded-xl text-white shadow-xl hover:shadow-inner focus:outline-none transition duration-500 ease-in-out transform hover:-translate-x hover:scale-105">
              {{#if consulta}}Actualizar{{else}}Registrar{{/if}}
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script>
  flatpickr("#calendar", {});
</script>