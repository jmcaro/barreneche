{{>sidebar}}

{{!-- Cabecera --}}
<div class="my-10 font-sans m-auto md:w-3/4 sm:w-2/4">
    <div class="flex items-center">
        <h1 class="text-2xl font-semibold ml-4 ">Seguimiento Consultas</h1>
        <a href="/user_consultation" class="btn btn-sm btn-primary ml-4">Volver <svg xmlns="http://www.w3.org/2000/svg"
                fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 15 3 9m0 0 6-6M3 9h12a6 6 0 0 1 0 12h-3" />
            </svg>


            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
        </a>
        <button onclick="my_modal_5.showModal()" class="btn btn-sm btn-success ml-4">Responder
            <svg class="w-6 h-6 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24"
                height="24" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd"
                    d="M9 2.221V7H4.221a2 2 0 0 1 .365-.5L8.5 2.586A2 2 0 0 1 9 2.22ZM11 2v5a2 2 0 0 1-2 2H4v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2h-7ZM8 16a1 1 0 0 1 1-1h6a1 1 0 1 1 0 2H9a1 1 0 0 1-1-1Zm1-5a1 1 0 1 0 0 2h6a1 1 0 1 0 0-2H9Z"
                    clip-rule="evenodd" />
            </svg>
        </button>
        <button onclick="my_modal_4.showModal()"class="btn btn-sm btn-secondary ml-4">Ayuda <svg
                xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
                <path fill-rule="evenodd"
                    d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25ZM12.75 9a.75.75 0 0 0-1.5 0v2.25H9a.75.75 0 0 0 0 1.5h2.25V15a.75.75 0 0 0 1.5 0v-2.25H15a.75.75 0 0 0 0-1.5h-2.25V9Z"
                    clip-rule="evenodd" />
            </svg>

            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
        </button>
    </div>
    <div class="divider"></div>
    
    <dialog id="my_modal_4" class="modal">
    <div class="modal-box w-11/12 max-w-5xl">
        {{>helps/helpCreateResponse}}
        <div class="modal-action">
        <form method="dialog">
      <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
    </form>
        <form method="dialog">
            <!-- if there is a button, it will close the modal -->
            <button class="btn">Close</button>
        </form>
        </div>
    </div>
    </dialog>
    {{!-- mODAL CREAR RESPUESTA --}}
    <dialog id="my_modal_5" class="modal">
    <div class="modal-box w-11/12 max-w-5xl">
        {{>response/createResponse}}
        <div class="modal-action">
        <form method="dialog">
      <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
    </form>
        <form method="dialog">
            <!-- if there is a button, it will close the modal -->
            <button class="btn">Close</button>
        </form>
        </div>
    </div>
    </dialog>


    


    <!-- Información de la consulta -->
    <div class="consulta-info my-5 p-5 bg-gray-100 rounded-lg shadow-md">
        <h2 class="text-xl font-bold">Consulta:</h2>
        <p><strong>Asunto:</strong> {{consulta.consulta}}</p>
        <p><strong>Estado:</strong> {{consulta.estado}}</p>
        <p><strong>Fecha de Creación:</strong> {{consulta.createdAt}}</p>
    </div>

    <!-- Información de la Categoría (si está relacionada) -->
    {{#if consulta.categoria}}
    <div class="categoria-info my-5 p-5 bg-gray-100 rounded-lg shadow-md">
        <h2 class="text-xl font-bold">Categoría</h2>
        <p><strong>Categoría:</strong> {{consulta.categoria.categoria}}</p>
        <p><strong>Descripción:</strong> {{consulta.categoria.descripcion}}</p>
    </div>
    {{/if}}

    <!-- Información de Usuarios Asignados -->
    <div class="usuarios-info my-5 p-5 bg-gray-100 rounded-lg shadow-md">
        <h2 class="text-xl font-bold">Usuarios Asignados</h2>

        {{#if consulta.Usuarios}}
        <ul>
            {{#each consulta.Usuarios}}
            <li class="my-3 p-3 bg-white rounded-md shadow">
                <p><strong>Nombre:</strong> {{primerNombre}} {{primerApellido}}</p>
                <p><strong>Correo:</strong> {{correo}}</p>
                <p><strong>Teléfono:</strong> {{telefono}}</p>
                <p><strong>Rol:</strong> {{roles.rol}}</p>
            </li>
            {{/each}}
        </ul>
        {{else}}
        <p>No hay usuarios asignados a esta consulta.</p>
        {{/if}}
    </div>
    
    {{!-- mODAL ver RESPUESTA --}}
    <dialog id="" class="modal">
    <div class="modal-box w-11/12 max-w-5xl">
        {{>response/viewResponse respuesta=respuesta consulta=consulta}}
        <div class="modal-action">
        <form method="dialog">
      <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
    </form>
        <form method="dialog">
            <!-- if there is a button, it will close the modal -->
            <button class="btn">Close</button>
        </form>
        </div>
    </div>
    </dialog>

<dialog id="viewResponse" class="modal">
  <div class="modal-box w-11/12 max-w-5xl">
    <div id="viewResponseContent"></div>
    <div class="modal-action">
      <form method="dialog">
        <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
      </form>
      <form method="dialog">
        <button class="btn">Close</button>
      </form>
    </div>
  </div>
</dialog>

    <!-- Respuestas a la consulta, si existen -->
    <div class="respuestas-info my-5 p-5 bg-gray-100 rounded-lg shadow-md">
        <h2 class="text-xl font-bold">Respuestas</h2>
        {{#if consulta.Responses}}
        <ul>
            {{#each consulta.Responses}}
            <li class="my-3 p-3 bg-white rounded-md shadow">
                <div class="flex justify-between items-center">
                    <div>
                        <p><strong>Respuesta:</strong> {{this.respuesta}}</p>
                        <p><strong>Fecha de Respuesta:</strong> {{this.fechaRespuesta}}</p>
                    </div>
                    <div class="inline-flex items-center rounded-md shadow-sm ml-auto">
                        <a href="/responses/edit/{{id}}"
                            class="text-slate-800 hover:text-blue-600 text-sm bg-white hover:bg-slate-100 border border-slate-200 rounded-l-lg font-medium px-4 py-2 inline-flex space-x-1 items-center">
                            <span><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                    stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                        d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
                                </svg>
                            </span>
                        </a>
                        <button onclick="openResponseModal('{{this.id}}')"
                            class="text-slate-800 hover:text-blue-600 text-sm bg-white hover:bg-slate-100 border-y border-slate-200 font-medium px-4 py-2 inline-flex space-x-1 items-center">
                            <span>
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                    stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                        d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                        d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                            </span>
                        </a>
                        <button onclick=deleteConfirmation('{{id}}','/usuarios/delete')
                            class="text-slate-800 hover:text-blue-600 text-sm bg-white hover:bg-slate-100 border border-slate-200 rounded-r-lg font-medium px-4 py-2 inline-flex space-x-1 items-center">
                            <span>
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                    stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                        d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                                </svg>
                            </span>
                        </button>
                    </div>
                </div>
            </li>
            
            {{/each}}
        </ul>
        {{else}}
        <p>No hay respuestas para esta consulta.</p>
        {{/if}}
    </div>

    <!-- Botón para regresar -->
    <div class="mt-5">
        <a href="/consultas" class="bg-blue-500 text-white px-4 py-2 rounded">Volver a Consultas</a>
    </div>
</div>
{{!-- datos modal --}}
<script>
  function openResponseModal(responseId) {
    fetch(`/responses/${responseId}`)
      .then(response => response.text())
      .then(html => {
        document.getElementById('viewResponseContent').innerHTML = html;
        document.getElementById('viewResponse').showModal();
      })
      .catch(error => console.error('Error al cargar la respuesta:', error));
  }
</script>
